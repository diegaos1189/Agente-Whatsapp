// Prisma schema - Pollos El Corralito WhatsApp Agent MVP
// Moneda: COP, montos almacenados como enteros (pesos, sin decimales).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Contacto y conversacion ----------

model Contact {
  id        String   @id @default(cuid())
  phone     String   @unique
  name      String?
  marketingOptInAt DateTime?
  marketingOptInSource String?
  marketingOptOutAt DateTime?
  marketingOptOutReason String?
  cartRecoveryOptOutAt DateTime?
  cartRecoveryOptOutReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversations Conversation[]
  orders        Order[]
  addresses     Address[]
  inboundWhatsAppMessages InboundWhatsAppMessage[]
  messageProcessingLease  ContactMessageProcessingLease?
  cartRecoveries CartRecovery[]
  reactivationCampaigns CustomerReactivationCampaign[]

  @@map("contacts")
}

model Conversation {
  id            String    @id @default(cuid())
  contactId     String
  contact       Contact   @relation(fields: [contactId], references: [id])
  status        String    @default("ACTIVE") // ConversationStatus
  isHandoff     Boolean   @default(false)
  handoffReason String?
  assignedAdminUserId String?
  assignedAdminUser   AdminUser? @relation("ConversationAssignee", fields: [assignedAdminUserId], references: [id], onDelete: SetNull)
  takenAt       DateTime?
  failedAttempts Int      @default(0)
  // Estado de la maquina de conversacion: paso actual del pedido, carrito en progreso, slots pendientes.
  context       Json      @default("{}")
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  messages Message[]
  handoffs Handoff[]
  auditEvents ConversationAuditEvent[]
  cartRecoveries CartRecovery[]

  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  direction      String // MessageDirection: INBOUND | OUTBOUND
  type           String // MessageType
  senderType     String? // CUSTOMER | BOT | HUMAN | SYSTEM
  adminUserId    String?
  adminUser      AdminUser? @relation("AdminUserMessages", fields: [adminUserId], references: [id], onDelete: SetNull)
  body           String
  // Notas de voz del cliente: se guarda como data URL (base64) para que el panel admin
  // pueda reproducirlas. No hay bucket de almacenamiento configurado en este template, asi
  // que se guarda inline — son archivos cortos, aceptable para este volumen.
  mediaUrl       String?
  raw            Json?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([adminUserId])
  @@map("messages")
}

model ProcessedWhatsAppMessage {
  id                String   @id @default(cuid())
  providerMessageId String   @unique
  fromPhone         String
  inboundType       String
  providerTimestamp String?
  createdAt         DateTime @default(now())

  @@index([createdAt])
  @@map("processed_whatsapp_messages")
}

model InboundWhatsAppMessage {
  id                  BigInt   @id @default(autoincrement())
  waMessageId         String   @unique
  contactId           String
  contact             Contact  @relation(fields: [contactId], references: [id])
  fromPhone           String
  customerName        String?
  inboundType         String
  text                String?
  mediaId             String?
  providerTimestamp   String?
  processingStatus    String   @default("PENDING")
  attempts            Int      @default(0)
  processingStartedAt DateTime?
  processedAt         DateTime?
  lastError           String?
  leaseExpiresAt      DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([contactId, id])
  @@index([contactId, processingStatus, id])
  @@index([processingStatus, leaseExpiresAt])
  @@map("inbound_whatsapp_messages")
}

model ContactMessageProcessingLease {
  contactId        String   @id
  contact          Contact  @relation(fields: [contactId], references: [id])
  leaseToken       String
  leaseExpiresAt   DateTime
  processingState  String
  currentMessageId BigInt?
  lastHeartbeatAt  DateTime?
  lastFinishedAt   DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([leaseExpiresAt])
  @@map("contact_message_processing_leases")
}

// ---------- Catalogo ----------

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  sortOrder Int       @default(0)
  parentCategoryId String?
  parent    Category? @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id])
  children  Category[] @relation("CategoryHierarchy")
  products  Product[]
  recommendationRules ProductRecommendation[]

  @@map("categories")
}

model Product {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  name        String
  description String?
  price       Int // COP, entero
  isAvailable Boolean  @default(true)
  sortOrder   Int      @default(0)
  /// Cuando el cliente pide algo ambiguo que matchea varias variantes del mismo producto
  /// por igual (ej: "un pollo" sin decir cuantas presas), se ofrece la marcada como default
  /// en vez de la primera del catalogo al azar. Configurable por negocio desde el panel.
  isDefaultVariant Boolean  @default(false)
  /// Sinonimos/frases que los clientes usan y que no estan literalmente en el nombre (ej:
  /// "pollo entero" para el combo de 8 presas). Se suman al matching junto con nombre+categoria.
  searchKeywords String?
  /// Cantidad de unidades/piezas que trae esta variante (ej: 8 para "8 presas", 6 para un
  /// six-pack). Opcional — solo aplica a productos donde eso tiene sentido. Se le pasa a la
  /// IA como dato real para que no invente ni confunda la cantidad con el numero de pedido.
  unitCount   Int?
  /// Si es true, este producto es un combo armado con otros productos del catalogo
  /// (ver comboItems) — en vez de un item suelto con precio propio sin composicion clara.
  isCombo     Boolean  @default(false)
  /// Productos que componen el combo: [{ productId, quantity }], maximo 6. Solo aplica si
  /// isCombo=true. Se usa para describirle al cliente exactamente que incluye, sin inventar.
  comboItems  Json     @default("[]")
  /// Si aparece en el mensaje de menu que el bot le manda al cliente. Sigue disponible
  /// para pedir por nombre aunque este apagado (ej: componentes que solo se venden dentro
  /// de un combo, no sueltos en la lista general).
  showInMenu  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]
  promotions Promotion[]
  recommendationsAsSource     ProductRecommendation[] @relation("RecommendationSourceProduct")
  recommendationsAsRecommended ProductRecommendation[] @relation("RecommendationRecommendedProduct")

  @@map("products")
}

model Promotion {
  id          String    @id @default(cuid())
  title       String
  description String
  isActive    Boolean   @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  /// Producto al que aplica el descuento (opcional — una promo puede ser general, sin
  /// producto especifico, y quedar descrita solo en "description").
  productId     String?
  product       Product? @relation(fields: [productId], references: [id])
  discountType  String? // "PERCENTAGE" | "FIXED_AMOUNT", null si no aplica descuento estructurado
  discountValue Int? // porcentaje (0-100) o monto fijo en la moneda del negocio, segun discountType
  /// Dias de la semana en que aplica (0=domingo ... 6=sabado), igual que Date.getDay(). Vacio
  /// ([]) significa que aplica todos los dias.
  daysOfWeek    Json      @default("[]")
  createdAt   DateTime  @default(now())

  @@map("promotions")
}

/// Regla backend-decidida de upsell/cross-sell: "si el carrito tiene X (producto o
/// categoria), ofrece Y". La IA nunca elige el producto recomendado, solo redacta la
/// oferta que ya resolvio backend (ver recommendationService.ts). Exactamente uno de
/// sourceProductId/sourceCategoryId debe estar definido (regla por producto o por categoria).
model ProductRecommendation {
  id                    String   @id @default(cuid())
  sourceProductId       String?
  sourceProduct         Product? @relation("RecommendationSourceProduct", fields: [sourceProductId], references: [id], onDelete: Cascade)
  sourceCategoryId      String?
  sourceCategory        Category? @relation(fields: [sourceCategoryId], references: [id], onDelete: Cascade)
  recommendedProductId  String
  recommendedProduct    Product  @relation("RecommendationRecommendedProduct", fields: [recommendedProductId], references: [id], onDelete: Cascade)
  recommendationType    String // "UPSELL" | "CROSS_SELL" | "ADD_ON"
  priority              Int      @default(0)
  active                Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([sourceProductId])
  @@index([sourceCategoryId])
  @@map("product_recommendations")
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faqs")
}

// ---------- Direcciones ----------

model Address {
  id           String   @id @default(cuid())
  contactId    String
  contact      Contact  @relation(fields: [contactId], references: [id])
  label        String?
  address      String
  neighborhood String?
  reference    String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@map("addresses")
}

// ---------- Pedidos ----------

model Order {
  id            String   @id @default(cuid())
  code          String   @unique
  /// Idempotencia especifica del checkout confirmado. Null para pedidos manuales o legacy.
  confirmationId String? @unique
  contactId     String
  contact       Contact  @relation(fields: [contactId], references: [id])
  status        String   @default("RECEIVED") // OrderStatus
  deliveryType  String // DeliveryType
  paymentMethod String? // PaymentMethod
  paymentStatus String   @default("PENDING") // PaymentStatus
  total         Int      @default(0)
  deliveryFee   Int      @default(0)
  address       String?
  neighborhood  String?
  reference     String?
  /// Numero para que el domiciliario contacte al cliente al entregar. Por defecto es el
  /// mismo numero de WhatsApp desde el que escribio, pero el cliente puede dar uno distinto
  /// (ej: esta pidiendo desde un celular ajeno o para alguien mas).
  contactPhone  String?
  scheduledFor  DateTime?
  /// true si el cliente hizo otro pedido mientras este seguia sin despachar (RECEIVED) —
  /// alerta visual en el panel para que el operador revise si hay que combinarlos.
  flaggedForReview Boolean @default(false)
  flagNote         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items    OrderItem[]
  payments Payment[]
  events   OrderEvent[]

  @@index([contactId, createdAt])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  /// Nullable a proposito: el producto se puede borrar del catalogo despues sin romper
  /// pedidos ya facturados (SetNull). Lo que realmente importa del historial es el nombre
  /// y el precio ya guardados abajo, no que el producto siga vivo en el catalogo.
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// Nombre del producto al momento de venderse (foto fija) — sobrevive aunque se borre el producto.
  productName String?
  quantity    Int
  unitPrice   Int
  notes       String?

  @@map("order_items")
}

model Payment {
  id            String    @id @default(cuid())
  orderId       String
  order         Order     @relation(fields: [orderId], references: [id])
  method        String // PaymentMethod
  status        String    @default("PENDING") // PaymentStatus
  amount        Int
  currency      String    @default("COP")
  provider      String    @default("MANUAL")
  idempotencyKey String?
  checkoutVersion Int?
  providerPaymentId String?
  providerReference String?
  externalReference String?
  paidAmount     Int      @default(0)
  refundedAmount Int      @default(0)
  paymentUrl     String?
  expiresAt      DateTime?
  proofImageUrl String?
  failureCode   String?
  failureMessage String?
  metadata      Json      @default("{}")
  reportedAt    DateTime?
  authorizedAt  DateTime?
  paidAt        DateTime?
  failedAt      DateTime?
  cancelledAt   DateTime?
  confirmedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  refunds       PaymentRefund[]
  webhookEvents PaymentWebhookEvent[]
  reconciliationIssues PaymentReconciliationIssue[]

  @@index([orderId, createdAt])
  @@index([status, createdAt])
  @@index([provider, providerReference])
  @@unique([provider, providerPaymentId])
  @@unique([provider, idempotencyKey])

  @@map("payments")
}

model PaymentRefund {
  id               String   @id @default(cuid())
  paymentId        String
  payment          Payment  @relation(fields: [paymentId], references: [id])
  amount           Int
  currency         String   @default("COP")
  status           String   @default("PENDING")
  idempotencyKey   String?
  providerRefundId String?
  reasonCode       String?
  requestedBy      String?
  metadata         Json     @default("{}")
  completedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([paymentId, createdAt])
  @@unique([paymentId, idempotencyKey])
  @@map("payment_refunds")
}

model PaymentWebhookEvent {
  id                 String   @id @default(cuid())
  paymentId          String?
  payment            Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  provider           String
  eventId            String
  eventType          String
  status             String   @default("RECEIVED")
  providerReference  String?
  rawPayload         Json     @default("{}")
  receivedAt         DateTime @default(now())
  processedAt        DateTime?
  createdAt          DateTime @default(now())

  @@unique([provider, eventId])
  @@index([provider, providerReference])
  @@map("payment_webhook_events")
}

model PaymentReconciliationIssue {
  id                String   @id @default(cuid())
  paymentId         String?
  payment           Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  issueType         String
  severity          String   @default("WARNING")
  expectedAmount    Int?
  providerAmount    Int?
  expectedCurrency  String?
  providerCurrency  String?
  providerReference String?
  note              String?
  resolvedAt        DateTime?
  createdAt         DateTime @default(now())

  @@index([issueType, createdAt])
  @@index([paymentId, createdAt])
  @@map("payment_reconciliation_issues")
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  status    String // OrderStatus
  note      String?
  createdAt DateTime @default(now())

  @@map("order_events")
}

// ---------- Escalamiento humano ----------

model Handoff {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  reason         String // HandoffReason
  note           String?
  requestedByAdminUserId String?
  requestedByAdminUser   AdminUser? @relation("RequestedHandoffs", fields: [requestedByAdminUserId], references: [id], onDelete: SetNull)
  resolvedByAdminUserId  String?
  resolvedByAdminUser    AdminUser? @relation("ResolvedHandoffs", fields: [resolvedByAdminUserId], references: [id], onDelete: SetNull)
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@map("handoffs")
}

model ConversationAuditEvent {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  adminUserId    String?
  adminUser      AdminUser?   @relation("ConversationAuditEvents", fields: [adminUserId], references: [id], onDelete: SetNull)
  eventType      String
  reason         String?
  note           String?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("conversation_audit_events")
}

// ---------- Configuracion del negocio ----------

model BusinessSettings {
  id                     String   @id @default(cuid())
  restaurantName         String
  /// Logo del negocio (data URL base64) para mostrar en el panel admin, arriba del menu.
  logoUrl                String?
  /// Fotos generales del menu (data URLs base64), maximo 5 — el bot las manda cuando el
  /// cliente pide ver el menu, antes de la lista de categorias numerada.
  menuImages             String[] @default([])
  phone                  String
  address                String
  currency               String   @default("COP")
  timezone               String   @default("America/Bogota")
  openingHours           Json // { mon: {open, close} | null, ... }
  deliveryFee            Int      @default(0)
  /// Si el negocio permite pedidos para entrega a domicilio.
  acceptsDelivery        Boolean  @default(true)
  /// Si el negocio permite pedidos para recoger en el local.
  acceptsPickup          Boolean  @default(true)
  /// Pedido minimo para domicilios. 0 = sin minimo.
  minimumDeliveryOrder   Int      @default(0)
  /// Lista opcional de palabras clave de cobertura (barrios, zonas, sectores). Vacio = sin restriccion.
  deliveryCoverageKeywords String[] @default([])
  estimatedPrepMinutes   Int      @default(30)
  acceptsScheduledOrders Boolean  @default(false)
  /// Metodos de pago que este negocio acepta (subconjunto de CASH/TRANSFER/CARD_ON_DELIVERY).
  /// Configurable desde el panel — el bot solo ofrece los que esten aqui.
  acceptedPaymentMethods String[] @default(["CASH", "TRANSFER", "CARD_ON_DELIVERY"])
  /// Cuentas para pagos por transferencia (maximo 4), solo aplica si TRANSFER esta en
  /// acceptedPaymentMethods. Cada una: { bankName, accountInfo, qrImage }. Se le comparten
  /// al cliente cuando elige pagar por transferencia.
  transferAccounts Json @default("[]")
  /// Hora (HH:MM, zona horaria = timezone de arriba) en la que se archivan automaticamente todas las conversaciones activas del dia.
  dailyArchiveTime       String   @default("23:30")
  outOfHoursMessage      String
  welcomeMessage         String
  /// Nombre propio del agente/asistente virtual (ej: "Sara"). Se usa en el saludo inicial
  /// ("Hola, bienvenido a {negocio}, me llamo {agentName}") — vacio = no menciona nombre propio.
  agentName              String   @default("")
  /// Como debe sonar el asistente al redactar respuestas (tono/personalidad), ej: "calido y cercano, con humor ligero".
  assistantTone          String   @default("Anfitrion virtual del negocio: atencion rapida, amable y personalizada. Ayuda a conocer el menu, recomienda segun gustos, resuelve dudas y gestiona pedidos con calidez y profesionalismo. Prioriza la satisfaccion del cliente, responde con claridad y nunca inventa informacion.")
  cartRecoveryEnabled    Boolean  @default(false)
  cartRecoveryDelayMinutes Int    @default(90)
  cartRecoveryMaxAttempts Int     @default(1)
  cartRecoveryMessage    String   @default("Hola 👋 Dejaste un pedido pendiente. Si quieres, seguimos desde donde quedamos.")
  /// Activa el upsell/cross-sell proactivo (ver ProductRecommendation). Apagado por
  /// defecto — opt-in conservador por deployment, igual que cartRecoveryEnabled.
  upsellEnabled          Boolean  @default(false)
  /// Maximo de ofertas de upsell distintas por carrito (no reintentos del mismo producto).
  maxUpsellOffers        Int      @default(1)
  /// Credenciales de la cuenta de WhatsApp Cloud API de ESTE cliente/negocio — editables
  /// desde Configuracion (panel admin) sin tocar .env ni redesplegar. "mock" no llama a Meta.
  whatsappProvider       String   @default("mock")
  whatsappPhoneNumberId  String   @default("")
  whatsappToken          String   @default("")
  whatsappAppSecret      String   @default("")
  whatsappVerifyToken    String   @default("")
  whatsappApiVersion     String   @default("v21.0")
  reactivationEnabled    Boolean  @default(false)
  reactivationTemplateName String @default("")
  reactivationTemplateLanguage String @default("es_CO")
  reactivationDormantDays Int     @default(30)
  reactivationCooldownDays Int    @default(30)
  updatedAt              DateTime @updatedAt

  @@map("business_settings")
}

model CartRecovery {
  id                    String       @id @default(cuid())
  contactId             String
  contact               Contact      @relation(fields: [contactId], references: [id])
  conversationId        String
  conversation          Conversation @relation(fields: [conversationId], references: [id])
  status                String       @default("PENDING")
  cartFingerprint       String
  scheduledCheckAt      DateTime
  lastCustomerMessageAt DateTime
  attempts              Int          @default(0)
  reminderSentAt        DateTime?
  resumedAt             DateTime?
  cancelledAt           DateTime?
  convertedOrderId      String?
  notEligibleReason     String?
  leaseToken            String?
  leaseExpiresAt        DateTime?
  lastEvaluatedAt       DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([status, scheduledCheckAt])
  @@index([conversationId, updatedAt])
  @@index([contactId, createdAt])
  @@map("cart_recoveries")
}

model CustomerReactivationCampaign {
  id               String   @id @default(cuid())
  contactId        String
  contact          Contact  @relation(fields: [contactId], references: [id])
  status           String   @default("PENDING")
  templateName     String
  templateLanguage String
  dormantDays      Int
  lastOrderAt      DateTime
  providerMessageId String?
  skipReason       String?
  sentAt           DateTime?
  convertedOrderId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([contactId, createdAt])
  @@index([status, createdAt])
  @@map("customer_reactivation_campaigns")
}

// ---------- Plataforma (dueño del producto) ----------

/// Negocio cliente de la plataforma, visible en /super-admin/restaurantes. Es el registro
/// central de clientes del dueño del producto; cada negocio sigue corriendo su propio
/// deployment del template (esta tabla no lo conecta todavia — multi-tenant real es trabajo
/// posterior).
model PlatformRestaurant {
  id         String   @id @default(cuid())
  name       String
  /// Identificador para el link publico del restaurante (<url-del-panel>/<slug>). Se genera
  /// del nombre al crearlo y no cambia aunque se renombre, para no romper links compartidos.
  slug       String   @unique
  city       String
  address    String   @default("")
  ownerPhone String   @default("")
  ownerEmail String   @default("")
  currency   String   @default("COP")
  status     String   @default("ACTIVE") // "ACTIVE" | "INACTIVE"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("platform_restaurants")
}

/// Lead capturado desde el formulario "Quiero una demo" de la landing publica (/).
/// No requiere autenticacion para crearse (envio publico); solo el dueño de la plataforma
/// puede listarlos/actualizarlos desde /super-admin/leads.
model Lead {
  id           String   @id @default(cuid())
  businessName String
  contactName  String
  phone        String
  email        String   @default("")
  message      String   @default("")
  status       String   @default("NEW") // "NEW" | "CONTACTED" | "CLOSED"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("leads")
}

// ---------- Usuarios del panel admin ----------

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         String   @default("STAFF") // "ADMIN" | "STAFF"
  /// Solo aplica si role = STAFF: secciones del panel habilitadas (ej: ["orders","conversations"]). ADMIN siempre tiene todas.
  permissions  String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  assignedConversations Conversation[] @relation("ConversationAssignee")
  messages     Message[] @relation("AdminUserMessages")
  requestedHandoffs Handoff[] @relation("RequestedHandoffs")
  resolvedHandoffs Handoff[] @relation("ResolvedHandoffs")
  conversationAuditEvents ConversationAuditEvent[] @relation("ConversationAuditEvents")

  @@map("admin_users")
}
