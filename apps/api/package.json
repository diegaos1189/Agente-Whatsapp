{
  "name": "@pollos/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "setup": "node scripts/setup-business.mjs"
  },
  "dependenciesMeta": {
    "@pollos/shared": {
      "injected": true
    }
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^11.2.0",
    "@google/generative-ai": "^0.21.0",
    "@pollos/shared": "workspace:*",
    "@prisma/client": "^5.20.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "openai": "^4.68.4",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
