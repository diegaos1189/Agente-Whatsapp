# ---------- Servidor ----------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Origen permitido para el panel admin (Next.js)
CORS_ORIGIN=http://localhost:3000
# Token compartido simple que el panel admin manda en header Authorization: Bearer <token>
ADMIN_API_TOKEN=change-me-admin-token

# ---------- Base de datos ----------
DATABASE_URL=postgresql://pollos:pollos@localhost:5434/pollos_corralito?schema=public

# ---------- Motor de IA ----------
# "gemini" (Google) o "openai". Cada uno usa su propia API key abajo.
AI_PROVIDER=gemini

# Google Gemini: crea tu key gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI (alternativo, solo si AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---------- Audio / transcripcion ----------
# Timeout maximo por intento de transcripcion.
AUDIO_TRANSCRIPTION_TIMEOUT_MS=45000
# Reintentos adicionales tras el primer intento (0 = sin retry).
AUDIO_TRANSCRIPTION_MAX_RETRIES=1
# Limite de tamano aceptado para notas de voz entrantes de WhatsApp.
MAX_WHATSAPP_AUDIO_SIZE_BYTES=16777216
# Limite de duracion si el proveedor logra reportarla; si no la reporta, no se bloquea por duracion.
MAX_WHATSAPP_AUDIO_DURATION_SECONDS=300
# MIMEs permitidos para notas de voz/audio entrante desde WhatsApp.
ALLOWED_WHATSAPP_AUDIO_MIME_TYPES=audio/ogg,audio/opus,audio/mpeg,audio/mp4,audio/aac,audio/amr
# Timeout maximo para pedir metadata y descargar media desde Meta.
WHATSAPP_MEDIA_DOWNLOAD_TIMEOUT_MS=20000

# ---------- WhatsApp Cloud API (Meta) ----------
# "mock" no llama a Meta, solo loguea y guarda en DB. Util para desarrollar sin numero real.
# "meta" usa credenciales reales de Meta Cloud API.
WHATSAPP_PROVIDER=mock
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
# String inventado por ti, debe coincidir con el configurado en el panel de Meta al verificar el webhook.
WHATSAPP_VERIFY_TOKEN=change-me-verify-token
# "Clave secreta de la app" (App Secret) de Meta for Developers > Configuracion basica.
# Recomendado en produccion: sin esto, cualquiera que adivine tu URL de webhook podria
# mandar mensajes falsos haciendose pasar por WhatsApp. Vacio = no valida (ok para dev/mock).
WHATSAPP_APP_SECRET=

# ---------- n8n (automatizaciones salientes) ----------
# Deja vacio para desactivar el envio (se loguea localmente igual). Ver docs/N8N_INTEGRATION.md
N8N_WEBHOOK_URL_ORDER_CREATED=
N8N_WEBHOOK_URL_PAYMENT_REMINDER=
N8N_WEBHOOK_URL_OPERATOR_NOTIFICATION=
N8N_WEBHOOK_URL_HANDOFF=
