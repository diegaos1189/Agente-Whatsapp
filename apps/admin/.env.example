# URL del backend (apps/api)
API_BASE_URL=http://localhost:4000
# Debe coincidir con ADMIN_API_TOKEN del backend. Solo se usa server-side, nunca se expone al navegador.
ADMIN_API_TOKEN=change-me-admin-token

# Login del panel: sin esto, cualquiera con la URL ve todo (conversaciones, pedidos, etc).
ADMIN_PANEL_USERNAME=change-me-username
ADMIN_PANEL_PASSWORD=change-me-panel-password
# Cualquier string largo y aleatorio, usado para firmar la cookie de sesion.
SESSION_SECRET=change-me-a-random-long-string
